<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rajasthan Blog – VacationPe</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Josefin+Sans:wght@300;400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --saffron:#E8650A;--saffron-light:#F5A623;--saffron-pale:#FDF3E7;
    --maroon:#7A1A2E;--maroon-deep:#4A0D1A;--maroon-light:#C4324A;
    --sand:#D4A96A;--sand-pale:#FAF3E8;
    --gold:#C9A227;--gold-light:#E8C547;
    --teal:#1A6B6E;--teal-light:#2A9EA3;
    --cream:#FEF9F0;--dark:#1C0A05;
    --text:#2D1208;--text-mid:#6B3A1F;--text-light:#A06040;
    --border:rgba(201,162,39,.25);--border-strong:rgba(201,162,39,.5);
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:'Cormorant Garamond',Georgia,serif;background:var(--cream);color:var(--text);min-height:100vh;overflow-x:hidden}
  body::before{content:'';position:fixed;inset:0;background-image:repeating-linear-gradient(0deg,transparent,transparent 40px,rgba(201,162,39,.025) 40px,rgba(201,162,39,.025) 41px),repeating-linear-gradient(90deg,transparent,transparent 40px,rgba(201,162,39,.025) 40px,rgba(201,162,39,.025) 41px);pointer-events:none;z-index:0}

  /* NAV */
  nav{position:sticky;top:0;z-index:100;background:var(--maroon-deep);border-bottom:2px solid var(--gold);padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:64px}
  .nav-logo{font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:700;color:var(--gold-light);text-decoration:none;letter-spacing:.02em}
  .nav-links{display:flex;gap:0;list-style:none}
  .nav-links a{font-family:'Josefin Sans',sans-serif;font-size:.75rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.75);text-decoration:none;padding:0 1rem;transition:color .2s}
  .nav-links a:hover,.nav-links a.active{color:var(--gold-light)}
  .nav-dropdown{position:relative}
  .nav-dropdown:hover .dropdown-menu{display:block}
  .dropdown-menu{display:none;position:absolute;top:100%;left:0;background:var(--maroon-deep);border:1px solid var(--gold);border-top:2px solid var(--gold);min-width:180px;z-index:200}
  .dropdown-menu a{display:block;padding:.6rem 1rem;border-bottom:1px solid rgba(201,162,39,.15);font-size:.7rem}
  .dropdown-menu a:last-child{border-bottom:none}
  .nav-cta{background:var(--saffron);color:white!important;padding:.5rem 1.25rem!important;border-radius:2px;font-family:'Josefin Sans',sans-serif!important;font-size:.7rem!important;font-weight:600!important;letter-spacing:.1em!important;text-transform:uppercase!important;text-decoration:none!important;transition:background .2s!important}
  .nav-cta:hover{background:var(--saffron-light)!important}

  /* HERO */
  .hero{position:relative;z-index:1;min-height:520px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:var(--maroon-deep)}
  .hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 100%,rgba(232,101,10,.3) 0%,transparent 70%),radial-gradient(ellipse 60% 80% at 20% 50%,rgba(122,26,46,.6) 0%,transparent 70%),radial-gradient(ellipse 60% 80% at 80% 50%,rgba(122,26,46,.6) 0%,transparent 70%),linear-gradient(180deg,#2D0A15 0%,#1C0508 100%)}
  .hero-mandala{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:600px;height:600px;opacity:.04;animation:spin 120s linear infinite}
  @keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}
  .corner-ornament{position:absolute;width:80px;height:80px;opacity:.35}
  .corner-ornament.tl{top:20px;left:20px}
  .corner-ornament.tr{top:20px;right:20px;transform:scaleX(-1)}
  .hero-content{position:relative;z-index:2;text-align:center;padding:4rem 2rem;max-width:800px}
  .hero-eyebrow{font-family:'Josefin Sans',sans-serif;font-size:.7rem;font-weight:600;letter-spacing:.25em;text-transform:uppercase;color:var(--gold);margin-bottom:1.5rem;display:flex;align-items:center;justify-content:center;gap:1rem}
  .hero-eyebrow::before,.hero-eyebrow::after{content:'';display:block;width:40px;height:1px;background:var(--gold);opacity:.6}
  .hero-title{font-family:'Playfair Display',serif;font-size:clamp(2.8rem,7vw,5rem);font-weight:900;color:#FFF8EE;line-height:1.05;margin-bottom:.3em}
  .hero-title em{font-style:italic;color:var(--saffron-light)}
  .hero-subtitle{font-family:'Cormorant Garamond',serif;font-size:1.3rem;font-weight:300;font-style:italic;color:rgba(255,248,238,.7);margin-bottom:2rem;letter-spacing:.02em}
  .hero-divider{display:flex;align-items:center;justify-content:center;gap:.75rem;margin-bottom:2rem}
  .hero-divider-line{width:60px;height:1px;background:linear-gradient(90deg,transparent,var(--gold))}
  .hero-divider-line.right{background:linear-gradient(90deg,var(--gold),transparent)}
  .hero-divider-gem{width:8px;height:8px;background:var(--gold);transform:rotate(45deg)}
  .hero-stats{display:flex;justify-content:center;gap:3rem;margin-top:1rem}
  .hero-stat{text-align:center}
  .hero-stat-num{font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:700;color:var(--gold-light);display:block;line-height:1}
  .hero-stat-label{font-family:'Josefin Sans',sans-serif;font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.5);margin-top:.25rem}

  /* ORNAMENT BAND */
  .ornament-band{background:var(--maroon);padding:.75rem 0;position:relative;z-index:1;overflow:hidden;display:flex;align-items:center;justify-content:center}
  .ornament-pattern{font-family:'Josefin Sans',sans-serif;font-size:.65rem;letter-spacing:.4em;text-transform:uppercase;color:var(--gold);opacity:.8}

  /* FILTER BAR */
  .filter-section{position:relative;z-index:1;background:white;border-bottom:1px solid var(--border);padding:1.25rem 2rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem}
  .filter-label{font-family:'Josefin Sans',sans-serif;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--text-light);margin-right:.75rem}
  .filter-tags{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}
  .filter-tag{font-family:'Josefin Sans',sans-serif;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;padding:.35rem .9rem;border:1px solid var(--border-strong);color:var(--text-mid);cursor:pointer;transition:all .2s;background:transparent;border-radius:1px}
  .filter-tag:hover,.filter-tag.active{background:var(--maroon);color:var(--gold-light);border-color:var(--maroon)}
  .search-wrap{position:relative;display:flex;align-items:center}
  .search-wrap input{font-family:'Josefin Sans',sans-serif;font-size:.75rem;letter-spacing:.05em;padding:.5rem 1rem .5rem 2.25rem;border:1px solid var(--border-strong);background:var(--cream);color:var(--text);width:220px;border-radius:1px;outline:none;transition:border-color .2s}
  .search-wrap input:focus{border-color:var(--gold)}
  .search-wrap input::placeholder{color:var(--text-light);opacity:.7}
  .search-icon{position:absolute;left:.6rem;color:var(--text-light);font-size:.85rem}

  /* FEATURED */
  .featured-section{position:relative;z-index:1;padding:3rem 2rem;max-width:1300px;margin:0 auto}
  .section-header{display:flex;align-items:center;gap:1rem;margin-bottom:2rem}
  .section-title{font-family:'Josefin Sans',sans-serif;font-size:.65rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--saffron)}
  .section-line{flex:1;height:1px;background:var(--border)}
  .featured-card{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--border-strong);background:white;overflow:hidden;cursor:pointer;transition:box-shadow .3s;text-decoration:none;color:inherit}
  .featured-card:hover{box-shadow:0 12px 48px rgba(122,26,46,.15)}
  .featured-image{position:relative;min-height:380px;overflow:hidden;background:var(--maroon-deep)}
  .featured-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
  .featured-card:hover .featured-image img{transform:scale(1.04)}
  .featured-badge{position:absolute;top:1.25rem;left:1.25rem;background:var(--saffron);color:white;font-family:'Josefin Sans',sans-serif;font-size:.6rem;font-weight:600;letter-spacing:.15em;text-transform:uppercase;padding:.35rem .75rem;z-index:3}
  .img-gradient-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(74,13,26,.5) 0%,transparent 50%);pointer-events:none}
  .featured-body{padding:3rem 2.5rem;display:flex;flex-direction:column;justify-content:center;position:relative}
  .featured-body::before{content:'';position:absolute;top:2rem;bottom:2rem;left:0;width:3px;background:linear-gradient(180deg,var(--saffron),var(--gold),var(--maroon))}
  .article-category{font-family:'Josefin Sans',sans-serif;font-size:.6rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--saffron);margin-bottom:1rem}
  .article-title{font-family:'Playfair Display',serif;font-weight:700;line-height:1.2;color:var(--maroon-deep);margin-bottom:1rem}
  .featured-body .article-title{font-size:2rem}
  .article-excerpt{font-family:'Cormorant Garamond',serif;font-size:1.1rem;font-weight:300;line-height:1.8;color:var(--text-mid);margin-bottom:1.5rem}
  .article-meta{display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem}
  .meta-item{font-family:'Josefin Sans',sans-serif;font-size:.65rem;letter-spacing:.08em;color:var(--text-light);display:flex;align-items:center;gap:.3rem}
  .meta-dot{width:3px;height:3px;border-radius:50%;background:var(--border-strong)}
  .read-more{display:inline-flex;align-items:center;gap:.5rem;font-family:'Josefin Sans',sans-serif;font-size:.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--maroon);text-decoration:none;border-bottom:1px solid var(--maroon);padding-bottom:2px;transition:all .2s;width:fit-content}
  .read-more:hover{color:var(--saffron);border-color:var(--saffron)}
  .read-more-arrow{transition:transform .2s}
  .read-more:hover .read-more-arrow{transform:translateX(4px)}

  /* BLOG GRID */
  .grid-section{position:relative;z-index:1;padding:0 2rem 4rem;max-width:1300px;margin:0 auto}
  .blog-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:2px;background:var(--border)}
  .blog-card{background:white;cursor:pointer;transition:all .25s;text-decoration:none;color:inherit;display:flex;flex-direction:column;overflow:hidden}
  .blog-card:hover{z-index:2;box-shadow:0 8px 40px rgba(122,26,46,.18);transform:translateY(-2px)}
  .card-image{height:210px;position:relative;overflow:hidden;background:var(--maroon-deep)}
  .card-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
  .blog-card:hover .card-image img{transform:scale(1.06)}
  .card-image-stripe{position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--saffron),var(--gold),var(--maroon-light));z-index:2}
  .card-label{position:absolute;top:.75rem;left:.75rem;background:rgba(74,13,26,.75);backdrop-filter:blur(4px);color:var(--gold-light);font-family:'Josefin Sans',sans-serif;font-size:.58rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:.25rem .6rem;z-index:3}
  .card-body{padding:1.5rem;flex:1;display:flex;flex-direction:column;border-top:1px solid var(--border)}
  .card-body .article-category{margin-bottom:.6rem}
  .card-body .article-title{font-size:1.25rem;margin-bottom:.75rem;line-height:1.25}
  .card-body .article-excerpt{font-size:1rem;margin-bottom:1rem;flex:1;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .card-footer{display:flex;align-items:center;justify-content:space-between;padding-top:1rem;border-top:1px solid var(--border);margin-top:auto}
  .card-tag{font-family:'Josefin Sans',sans-serif;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:.25rem .6rem;border:1px solid;border-radius:1px}
  .tag-heritage{color:var(--maroon);border-color:rgba(122,26,46,.4);background:rgba(122,26,46,.05)}
  .tag-nature{color:var(--teal);border-color:rgba(26,107,110,.4);background:rgba(26,107,110,.05)}
  .tag-culture{color:var(--saffron);border-color:rgba(232,101,10,.4);background:rgba(232,101,10,.07)}
  .tag-guide{color:var(--gold);border-color:rgba(201,162,39,.5);background:rgba(201,162,39,.07)}
  .tag-food{color:#8B4513;border-color:rgba(139,69,19,.4);background:rgba(139,69,19,.05)}
  .card-read-time{font-family:'Josefin Sans',sans-serif;font-size:.6rem;letter-spacing:.08em;color:var(--text-light)}

  /* TWO COL */
  .two-col{display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:start;max-width:1300px;margin:0 auto;padding:0 2rem 4rem;position:relative;z-index:1}
  .sidebar{position:sticky;top:80px}
  .sidebar-card{background:white;border:1px solid var(--border-strong);padding:1.75rem;margin-bottom:1.5rem}
  .sidebar-title{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--maroon-deep);margin-bottom:1.25rem;padding-bottom:.75rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.6rem}
  .sidebar-title::before{content:'';display:block;width:4px;height:18px;background:var(--saffron);border-radius:1px}
  .quick-links{list-style:none}
  .quick-links li{border-bottom:1px solid var(--border);padding:.6rem 0}
  .quick-links li:last-child{border-bottom:none}
  .quick-links a{font-family:'Josefin Sans',sans-serif;font-size:.75rem;letter-spacing:.05em;color:var(--text-mid);text-decoration:none;display:flex;justify-content:space-between;align-items:center;transition:color .2s}
  .quick-links a:hover{color:var(--saffron)}
  .quick-links-arrow{font-size:.7rem;opacity:.5;transition:transform .2s}
  .quick-links a:hover .quick-links-arrow{transform:translateX(3px);opacity:1}
  .best-time-grid{display:grid;grid-template-columns:1fr 1fr;gap:.5rem}
  .season-pill{text-align:center;padding:.6rem .5rem;border:1px solid var(--border);border-radius:2px}
  .season-pill-name{font-family:'Josefin Sans',sans-serif;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--text-light);display:block}
  .season-pill-months{font-family:'Cormorant Garamond',serif;font-size:.9rem;font-weight:600;color:var(--text);display:block;margin-top:.15rem}
  .season-pill.peak{border-color:var(--gold);background:rgba(201,162,39,.05)}
  .season-pill.peak .season-pill-name{color:var(--gold)}
  .cta-box{background:var(--maroon-deep);padding:1.75rem;text-align:center;border:1px solid var(--gold);position:relative;overflow:hidden;margin-bottom:1.5rem}
  .cta-box-title{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:700;color:#FFF8EE;margin-bottom:.5rem}
  .cta-box-sub{font-family:'Cormorant Garamond',serif;font-size:1rem;font-style:italic;color:rgba(255,248,238,.65);margin-bottom:1.25rem;line-height:1.6}
  .cta-btn{display:inline-block;background:var(--saffron);color:white;font-family:'Josefin Sans',sans-serif;font-size:.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:.7rem 1.5rem;text-decoration:none;border-radius:1px;transition:background .2s}
  .cta-btn:hover{background:var(--saffron-light)}

  /* NEWSLETTER */
  .newsletter-band{position:relative;z-index:1;background:var(--maroon);padding:4rem 2rem;text-align:center;overflow:hidden}
  .newsletter-band::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--saffron),var(--gold),var(--saffron))}
  .newsletter-title{font-family:'Playfair Display',serif;font-size:2.2rem;font-weight:700;color:#FFF8EE;margin-bottom:.5rem}
  .newsletter-sub{font-family:'Cormorant Garamond',serif;font-size:1.1rem;font-style:italic;color:rgba(255,248,238,.7);margin-bottom:2rem}
  .newsletter-form{display:flex;gap:0;max-width:460px;margin:0 auto}
  .newsletter-input{flex:1;padding:.8rem 1rem;border:1px solid rgba(201,162,39,.5);border-right:none;background:rgba(255,255,255,.08);color:white;font-family:'Josefin Sans',sans-serif;font-size:.8rem;letter-spacing:.05em;outline:none;border-radius:0}
  .newsletter-input::placeholder{color:rgba(255,255,255,.45)}
  .newsletter-input:focus{border-color:var(--gold)}
  .newsletter-btn{padding:.8rem 1.5rem;background:var(--gold);color:var(--dark);font-family:'Josefin Sans',sans-serif;font-size:.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;border:none;cursor:pointer;transition:background .2s;border-radius:0}
  .newsletter-btn:hover{background:var(--gold-light)}

  /* FOOTER */
  footer{background:var(--dark);padding:3rem 2rem 1.5rem;position:relative;z-index:1;border-top:2px solid var(--maroon)}
  .footer-inner{max-width:1300px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:2rem;margin-bottom:2rem}
  .footer-logo{font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:700;color:var(--gold-light);margin-bottom:.75rem}
  .footer-tagline{font-family:'Cormorant Garamond',serif;font-size:1rem;font-style:italic;color:rgba(255,255,255,.45);line-height:1.6}
  .footer-col-title{font-family:'Josefin Sans',sans-serif;font-size:.65rem;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);margin-bottom:1rem}
  .footer-links{list-style:none}
  .footer-links li{margin-bottom:.5rem}
  .footer-links a{font-family:'Josefin Sans',sans-serif;font-size:.75rem;color:rgba(255,255,255,.5);text-decoration:none;letter-spacing:.03em;transition:color .2s}
  .footer-links a:hover{color:var(--gold-light)}
  .footer-bottom{max-width:1300px;margin:0 auto;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;align-items:center}
  .footer-copy{font-family:'Josefin Sans',sans-serif;font-size:.65rem;letter-spacing:.05em;color:rgba(255,255,255,.35)}

  /* RESPONSIVE */
  @media(max-width:960px){
    .featured-card{grid-template-columns:1fr}
    .featured-image{min-height:260px}
    .two-col{grid-template-columns:1fr}
    .sidebar{position:static}
    .footer-inner{grid-template-columns:1fr 1fr}
    nav .nav-links{display:none}
  }
  @media(max-width:640px){
    .blog-grid{grid-template-columns:1fr}
    .footer-inner{grid-template-columns:1fr}
    .hero-stats{gap:1.5rem}
    .newsletter-form{flex-direction:column}
    .newsletter-input{border-right:1px solid rgba(201,162,39,.5);border-bottom:none}
  }

  /* ANIMATIONS */
  @keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
  .hero-content>*{animation:fadeUp .7s ease both}
  .hero-eyebrow{animation-delay:.1s}
  .hero-title{animation-delay:.25s}
  .hero-subtitle{animation-delay:.4s}
  .hero-divider{animation-delay:.5s}
  .hero-stats{animation-delay:.6s}

  /* IMAGE FALLBACK — shows gradient if image fails to load */
  .card-image img.img-fallback, .featured-image img.img-fallback {opacity:0}
  .card-image{background:linear-gradient(135deg,#3D1A00,#7A1A2E)}
</style>
</head>
